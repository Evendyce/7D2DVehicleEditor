<UserControl x:Class="SevenDaysVehicleEditor.ProgressionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="Progression Editor" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Progression.xml is split into clean sections, so this module now covers the top-level level settings and safe attribute overrides before expanding into skills, crafting skills, and perks." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,12,0"
                             Padding="10,8"
                             IsReadOnly="True"
                             Text="{Binding ProgressionFilePath}" />

                    <Button Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="BrowseProgressionFileClick"
                            Content="Browse..." />

                    <Button Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="ReloadProgressionFileClick"
                            Content="Reload" />

                    <Button Grid.Column="3"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="{Binding HasActiveProgressionFile}"
                            Click="SaveProgressionFileClick"
                            Content="Save" />

                    <Button Grid.Column="4"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="{Binding HasActiveProgressionFile}"
                            Click="CreateProgressionBackupClick"
                            Content="Create Backup" />

                    <Button Grid.Column="5"
                            Padding="14,8"
                            IsEnabled="{Binding CanRestoreProgressionBackup}"
                            Click="RestoreProgressionBackupClick"
                            Content="Restore Backup" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding ProgressionStatusMessage}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Level">
                <Border Padding="18"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,12">
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Level Settings" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="These are the simple top-level progression values that control level cap, XP scaling, and skill point gain." />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ProgressionLevelProperties}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="260" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                <DataGridTextColumn Width="340" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Attributes">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Attributes" />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Shared defaults live at the top-level attributes node. Individual attributes below only expose simple, predictable top-level overrides in this first pass." />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Shared Defaults" />

                            <DataGrid DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      Height="170"
                                      ItemsSource="{Binding ProgressionAttributeDefaultsProperties}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="150" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Individual Attributes" />

                            <ListBox ItemsSource="{Binding ProgressionAttributes}"
                                     SelectedItem="{Binding SelectedProgressionAttribute}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{Binding Summary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedProgressionAttribute.DisplayName, TargetNullValue=No Attribute Selected}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedProgressionAttributeSummary}" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="0,0,12,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="Internal Name" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedProgressionAttribute.Name}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,0,12,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="Icon" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedProgressionAttribute.Icon}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Margin="0,0,12,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="Name Key" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedProgressionAttribute.NameKey}" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Margin="0,0,12,0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="Description Key" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedProgressionAttribute.DescriptionKey}" />
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding SelectedProgressionAttributeProperties}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                    <DataGridTextColumn Width="300" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Skills">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Skills" />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="This section is read-only. It helps inspect skill and book-group metadata without implying these entries are safe progression edits." />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Section Defaults" />

                            <DataGrid DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      Height="130"
                                      ItemsSource="{Binding ProgressionSkillDefaultsProperties}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="150" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Value}" Header="Value" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Entries" />

                            <ListBox ItemsSource="{Binding ProgressionSkills}"
                                     SelectedItem="{Binding SelectedProgressionSkill}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{Binding TypeLabel}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedProgressionSkill.DisplayName, TargetNullValue=No Skill Selected}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedProgressionSkillSummary}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Entry Type" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.TypeLabel, Mode=OneWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Internal Name" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.Name, Mode=OneWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Parent" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.Parent, Mode=OneWay}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Icon" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.Icon, Mode=OneWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Name Key" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.NameKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Description Key" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.DescriptionKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Long Description Key" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionSkill.LongDescriptionKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Hidden / Effects" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}">
                                    <Run Text="{Binding SelectedProgressionSkill.Hidden, Mode=OneWay, TargetNullValue=''}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SelectedProgressionSkill.EffectGroupCount, Mode=OneWay, StringFormat=Effect groups: {0}}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Crafting Skills">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Crafting Skills" />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="This section is read-only. Crafting skills combine unlock displays, item unlocks, and passive effect curves, so the app avoids presenting them as safe edits." />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Section Defaults" />

                            <DataGrid DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      Height="100"
                                      ItemsSource="{Binding ProgressionCraftingSkillDefaultsProperties}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="150" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Value}" Header="Value" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Entries" />

                            <ListBox ItemsSource="{Binding ProgressionCraftingSkills}"
                                     SelectedItem="{Binding SelectedProgressionCraftingSkill}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{Binding Parent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedProgressionCraftingSkill.DisplayName, TargetNullValue=No Crafting Skill Selected}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedProgressionCraftingSkillSummary}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Internal Name" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.Name, Mode=OneWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Parent" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.Parent, Mode=OneWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Max Level" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.MaxLevel, Mode=OneWay}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Icon" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.Icon, Mode=OneWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Name Key" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.NameKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Description Key" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.DescriptionKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Long Description Key" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionCraftingSkill.LongDescriptionKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Structure" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}">
                                    <Run Text="{Binding SelectedProgressionCraftingSkill.DisplayEntryCount, Mode=OneWay, StringFormat=Display entries: {0}}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SelectedProgressionCraftingSkill.UnlockEntryCount, Mode=OneWay, StringFormat=Unlock entries: {0}}" />
                                    <LineBreak />
                                    <Run Text="{Binding SelectedProgressionCraftingSkill.EffectGroupCount, Mode=OneWay, StringFormat=Effect groups: {0}}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SelectedProgressionCraftingSkill.PassiveEffectCount, Mode=OneWay, StringFormat=Passive effects: {0}}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Perks">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Perks" />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="This section is read-only. Perks combine rank requirements, passive effects, triggered effects, and description text, so the app avoids presenting them as safe edits." />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Section Defaults" />

                            <DataGrid DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      Height="170"
                                      ItemsSource="{Binding ProgressionPerkDefaultsProperties}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="150" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Value}" Header="Value" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Entries" />

                            <ListBox ItemsSource="{Binding ProgressionPerks}"
                                     SelectedItem="{Binding SelectedProgressionPerk}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{Binding Parent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedProgressionPerk.DisplayName, TargetNullValue=No Perk Selected}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedProgressionPerkSummary}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Internal Name" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.Name, Mode=OneWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Parent" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.Parent, Mode=OneWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Max Level" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.MaxLevel, Mode=OneWay}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Override Cost" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.OverrideCost, Mode=OneWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Icon" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.Icon, Mode=OneWay}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Name Key" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.NameKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Description Key" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SelectedProgressionPerk.DescriptionKey, Mode=OneWay}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Structure" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}">
                                    <Run Text="{Binding SelectedProgressionPerk.LevelRequirementCount, Mode=OneWay, StringFormat=Requirements: {0}}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SelectedProgressionPerk.EffectGroupCount, Mode=OneWay, StringFormat=Effect groups: {0}}" />
                                    <LineBreak />
                                    <Run Text="{Binding SelectedProgressionPerk.PassiveEffectCount, Mode=OneWay, StringFormat=Passive effects: {0}}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SelectedProgressionPerk.TriggeredEffectCount, Mode=OneWay, StringFormat=Triggered effects: {0}}" />
                                    <LineBreak />
                                    <Run Text="{Binding SelectedProgressionPerk.EffectDescriptionCount, Mode=OneWay, StringFormat=Descriptions: {0}}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="14"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Tip: this progression pass safely edits the top-level &lt;level&gt; block, shared attribute defaults, and simple per-attribute overrides. Skills, crafting skills, and perks are intentionally read-only so the app does not tempt users into unsafe progression edits." />
        </Border>
    </Grid>
</UserControl>

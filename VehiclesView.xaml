<UserControl x:Class="SevenDaysVehicleEditor.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SevenDaysVehicleEditor"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="Vehicle Editor" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="A safer editor for vehicles.xml with automatic backups, grouped tuning fields, and support for any vehicle entries found in the selected config file." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,12,0"
                             Padding="10,8"
                             IsReadOnly="True"
                             Text="{Binding CurrentFilePath}" />

                    <Button Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="BrowseFileClick"
                            Content="{Binding BrowseButtonText}" />

                    <Button Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="ReloadFileClick"
                            Content="{Binding ReloadButtonText}" />

                    <Button Grid.Column="3"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="{Binding HasActiveFile}"
                            Click="SaveFileClick"
                            Content="Save" />

                    <Button Grid.Column="4"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="{Binding HasActiveFile}"
                            Click="CreateBackupClick"
                            Content="Create Backup" />

                    <Button Grid.Column="5"
                            Padding="14,8"
                            IsEnabled="{Binding CanRestoreBackup}"
                            Click="RestoreBackupClick"
                            Content="Restore Backup" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" />

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Padding="12"
                        Background="{StaticResource PanelSoftBrush}"
                        BorderBrush="{StaticResource PanelEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Performance Multiplier" />

                        <TextBox Width="88"
                                 Margin="0,0,12,0"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding MultiplierText, UpdateSourceTrigger=PropertyChanged}" />

                        <RadioButton Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     GroupName="MultiplierScope"
                                     IsChecked="{Binding ApplyToSelectedVehicle}"
                                     Content="Selected Vehicle" />

                        <RadioButton Margin="0,0,16,0"
                                     VerticalAlignment="Center"
                                     GroupName="MultiplierScope"
                                     IsChecked="{Binding ApplyToAllVehicles}"
                                     Content="All Vehicles" />

                        <CheckBox Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AffectMotorTorque}"
                                  Content="Motor Torque / Turbo" />

                        <CheckBox Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AffectMaxVelocity}"
                                  Content="Max Velocity / Turbo" />

                        <CheckBox Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AffectBrakeTorque}"
                                  Content="Brake Torque" />

                        <Button Padding="14,6"
                                Margin="0,0,12,0"
                                Click="ApplyPerformanceMultiplierClick"
                                Content="Apply" />

                        <TextBlock MaxWidth="520"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding MultiplierHelpText}" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Vanilla">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Vehicles" />

                            <ListBox ItemsSource="{Binding VanillaVehicles}"
                                     SelectedItem="{Binding SelectedVanillaVehicle}"
                                     DisplayMemberPath="Name" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding CurrentVehicle.Name, TargetNullValue=No Vehicle Selected}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding CurrentVehicleSummary}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Expander IsExpanded="True"
                                              Header="Performance"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenPerformanceEditorCommand}">
                                        <DataGrid ItemsSource="{Binding PerformanceProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander IsExpanded="True"
                                              Header="Handling"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenHandlingEditorCommand}">
                                        <DataGrid ItemsSource="{Binding HandlingProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander IsExpanded="True"
                                              Header="Fuel And Utility"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenFuelEditorCommand}">
                                        <DataGrid ItemsSource="{Binding FuelProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander IsExpanded="True"
                                              Header="Extras"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenExtrasEditorCommand}">
                                        <DataGrid ItemsSource="{Binding ExtraProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander Header="Advanced Raw Properties">
                                        <DataGrid ItemsSource="{Binding AdvancedProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="160" Binding="{Binding Section}" Header="Section" IsReadOnly="True" />
                                                <DataGridTextColumn Width="220" Binding="{Binding PropertyName}" Header="Property" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Modded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,6"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Vehicle Mods" />
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding ModSummary}" />

                            <TreeView ItemsSource="{Binding ModFolders}"
                                      PreviewMouseLeftButtonDown="ModTreePreviewMouseLeftButtonDown"
                                      SelectedItemChanged="ModTreeSelectionChanged">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type local:ModFolderConfig}"
                                                              ItemsSource="{Binding Vehicles}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{Binding VehicleCountLabel}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <DataTemplate DataType="{x:Type local:ModVehicleNode}">
                                        <Border Background="#44111615"
                                                BorderBrush="{StaticResource PanelEdgeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5">
                                            <TextBlock Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding CurrentVehicle.Name, TargetNullValue=No Vehicle Selected}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding CurrentVehicleSummary}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Expander IsExpanded="True"
                                              Header="Performance"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenPerformanceEditorCommand}">
                                        <DataGrid ItemsSource="{Binding PerformanceProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander IsExpanded="True"
                                              Header="Handling"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenHandlingEditorCommand}">
                                        <DataGrid ItemsSource="{Binding HandlingProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander IsExpanded="True"
                                              Header="Fuel And Utility"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenFuelEditorCommand}">
                                        <DataGrid ItemsSource="{Binding FuelProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander IsExpanded="True"
                                              Header="Extras"
                                              local:ExpanderAssist.ActionButtonContent="Edit"
                                              local:ExpanderAssist.ActionButtonCommand="{Binding RelativeSource={RelativeSource AncestorType=local:VehiclesView}, Path=OpenExtrasEditorCommand}">
                                        <DataGrid ItemsSource="{Binding ExtraProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="220" Binding="{Binding DisplayName}" Header="Setting" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                                <DataGridTextColumn Width="260" Binding="{Binding Description}" Header="Notes" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander Header="Advanced Raw Properties">
                                        <DataGrid ItemsSource="{Binding AdvancedProperties}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="160" Binding="{Binding Section}" Header="Section" IsReadOnly="True" />
                                                <DataGridTextColumn Width="220" Binding="{Binding PropertyName}" Header="Property" IsReadOnly="True" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="14"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Tip: vanilla reads directly from Data\Config\vehicles.xml. Modded mode scans the game's Mods folder, checks each mod's Config\vehicles.xml, and groups discovered vehicles underneath the mod that owns them." />
        </Border>
    </Grid>
</UserControl>

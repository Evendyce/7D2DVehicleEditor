<Window x:Class="SevenDaysVehicleEditor.Controls.SectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SevenDaysVehicleEditor.Controls"
        mc:Ignorable="d"
        Title="Section Editor"
        Width="860"
        Height="620"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppFogBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <controls:DynamicEditorFormControl Header="{Binding Header}"
                                                   Description="{Binding Description}"
                                                   ItemsSource="{Binding Fields}" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button MinWidth="120"
                    Padding="14,8"
                    Click="CloseClick"
                    Content="Done" />
        </StackPanel>
    </Grid>
</Window>

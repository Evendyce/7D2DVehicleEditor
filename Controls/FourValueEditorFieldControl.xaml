<UserControl x:Class="SevenDaysVehicleEditor.Controls.FourValueEditorFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="640">
    <Border Margin="0,0,0,12"
            Padding="12"
            Background="{StaticResource PanelSoftBrush}"
            BorderBrush="{StaticResource PanelEdgeBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{Binding Label}" />

            <UniformGrid Grid.Row="1"
                         Margin="0,10,0,0"
                         Columns="4">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding FirstLabel}" />
                    <TextBox Padding="10,8"
                             IsReadOnly="{Binding IsReadOnly}"
                             Text="{Binding FirstValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding SecondLabel}" />
                    <TextBox Padding="10,8"
                             IsReadOnly="{Binding IsReadOnly}"
                             Text="{Binding SecondValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding ThirdLabel}" />
                    <TextBox Padding="10,8"
                             IsReadOnly="{Binding IsReadOnly}"
                             Text="{Binding ThirdValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding FourthLabel}" />
                    <TextBox Padding="10,8"
                             IsReadOnly="{Binding IsReadOnly}"
                             Text="{Binding FourthValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Description}" />
        </Grid>
    </Border>
</UserControl>

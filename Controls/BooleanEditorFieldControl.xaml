<UserControl x:Class="SevenDaysVehicleEditor.Controls.BooleanEditorFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SevenDaysVehicleEditor.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="480">
    <Border Margin="0,0,0,12"
            Padding="12"
            Background="{StaticResource PanelSoftBrush}"
            BorderBrush="{StaticResource PanelEdgeBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>
            <CheckBox FontWeight="SemiBold"
                      IsChecked="{Binding Value}"
                      IsEnabled="{Binding IsReadOnly, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                      Content="{Binding Label}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Description}" />
        </StackPanel>
    </Border>
</UserControl>

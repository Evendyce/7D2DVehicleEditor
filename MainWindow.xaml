<Window x:Class="SevenDaysVehicleEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SevenDaysVehicleEditor"
        mc:Ignorable="d"
        Title="7 Days Vehicle Editor"
        Height="760"
        Width="1240"
        MinHeight="640"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppFogBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AppShadowBrush}" />

        <Border Grid.Row="1"
                Margin="16"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="7 Days To Die Config Editor" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="A focused editor for 7 Days To Die config files. Vehicles is live now, and Progression has its own module ready for expansion." />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2"
                    Margin="16,0,16,16">
            <TabItem Header="Vehicles">
                <local:VehiclesView />
            </TabItem>

            <TabItem Header="Progression">
                <local:ProgressionView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
